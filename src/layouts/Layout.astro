---
import "../styles/global.css";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer";

interface Props {
	title?: string;
}

const { title } = Astro.props;

// SEO Variables (Restoring your high-ranking keywords)
const defaultTitle = "Nipah Virus Tracker 2026 (NiV) | Real-Time India & Global Map";
const pageTitle = title ? `${title} | Nipah Virus Tracker 2026 (NiV)` : defaultTitle;
const seoDescription = "Live 2026 Nipah Virus (NiV) outbreak tracker. Real-time map of confirmed cases in West Bengal, India, and globally. Official data from WHO & NCDC. Offline-ready safety guide.";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<title>{pageTitle}</title>
		<meta name="title" content={pageTitle} />
		<meta name="description" content={seoDescription} />

		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-X94T6M1W3K"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-X94T6M1W3K', { send_page_view: false });
		</script>

		<script type="application/ld+json" is:inline>
			{
				"@context": "https://schema.org",
				"@type": "WebSite",
				"name": "NiV-Tracker 2026",
				"url": "https://nipahtracker.online",
				"description": "Real-time AI-powered tracker for the 2026 Nipah Virus outbreak. Live maps, case counts, and safety guidelines from WHO/NCDC.",
				"author": {
					"@type": "Organization",
					"name": "NiV-Tracker Initiative"
				}
			}
		</script>

		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={seoDescription} />
		<meta property="og:image" content="/favicon.svg" />

		<meta property="twitter:card" content="summary" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={pageTitle} />
		<meta property="twitter:description" content={seoDescription} />
		<meta property="twitter:image" content="/favicon.svg" />

		<meta name="robots" content="index, follow" />
	</head>

	<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col font-sans">
		<header class="bg-white shadow-sm sticky top-0 z-50">
			<Navbar client:load />
		</header>

		<main class="flex-grow max-w-4xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8">
			<slot />
		</main>

		<Footer client:load />

		<nav class="md:hidden fixed bottom-0 w-full bg-white border-t border-gray-200 flex justify-around py-2 text-xs font-medium text-gray-500 pb-safe z-50">
			<a href="/" class="flex flex-col items-center justify-center gap-1 hover:text-red-600 min-h-[44px] min-w-[64px]">
				<span>Home</span>
			</a>
			<a href="/tracker" class="flex flex-col items-center justify-center gap-1 hover:text-red-600 min-h-[44px] min-w-[64px]">
				<span>Tracker</span>
			</a>
			<a href="/news" class="flex flex-col items-center justify-center gap-1 hover:text-red-600 min-h-[44px] min-w-[64px]">
				<span>News</span>
			</a>
			<a href="/safety" class="flex flex-col items-center justify-center gap-1 hover:text-red-600 min-h-[44px] min-w-[64px]">
				<span>Safety</span>
			</a>
			<a href="/about" class="flex flex-col items-center justify-center gap-1 hover:text-red-600 min-h-[44px] min-w-[64px]">
				<span>About</span>
			</a>
		</nav>

	<script is:inline>
		document.addEventListener('astro:page-load', function() {
			if (typeof gtag !== 'undefined') {
				gtag('event', 'page_view', {
					page_title: document.title,
					page_location: window.location.href
				});
			}
		});
	</script>
	</body>
</html>
